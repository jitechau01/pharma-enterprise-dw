# Copy to .env and fill in. Never commit .env.
#
# Airflow connection URI format:
#   snowflake://<user>:<password>@<account>/<database>/<schema>?warehouse=<wh>&role=<role>
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=snowflake://SVC_PHARMA_DBT:CHANGE_ME@your_account/PHARMA_DBT_DEV/STAGING?warehouse=PHARMA_TRANSFORMING_WH_DEV&role=PHARMA_TRANSFORMER_DEV

# aws://<access_key>:<secret_key>@?region_name=us-east-1
# (prefer an instance/task role in real deployments; access keys are for local dev only)
AIRFLOW_CONN_AWS_DEFAULT=aws://CHANGE_ME:CHANGE_ME@?region_name=us-east-1

PHARMA_DW_RAW_BUCKET=dev-pharma-raw-landing-xxxxxx
PHARMA_DW_DAG_FAILURE_SNS_TOPIC_ARN=
